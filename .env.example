# Copy to .env and fill in ONE provider's key (whichever you configure in the
# harness). .env is git-ignored — never commit real keys.

# OpenAI / OpenAI-compatible
OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# DeepSeek (api.deepseek.com — paid, no free tier)
DEEPSEEK_API_KEY=

# Leave telemetry disabled unless you explicitly want it.
DSH_TELEMETRY_MODE=DISABLED
